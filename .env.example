# Copy this file to .env and fill in your keys.

# Required by both scripts. https://console.cloud.google.com/
# Enable "Directions API" and "Geocoding API".
GOOGLE_MAPS_API_KEY=

# Required only by analyze_listings.py.
# The variable NAME is whatever you set in config.json -> listings.llm_api_key_env
# (default DEEPSEEK_API_KEY). https://platform.deepseek.com/
DEEPSEEK_API_KEY=
