<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sweep at 10:00, 16:00 and 22:00.
  Replace /PATH/TO/rent-radar with the checkout's absolute path, then install with:
     cp com.rentradar.refresh.plist ~/Library/LaunchAgents/
     launchctl load -w ~/Library/LaunchAgents/com.rentradar.refresh.plist
  Stop with:
     launchctl unload -w ~/Library/LaunchAgents/com.rentradar.refresh.plist
  Unlike cron, launchd runs a missed job once the Mac wakes up.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rentradar.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/rent-radar/.venv/bin/python</string>
    <string>/PATH/TO/rent-radar/refresh.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PATH/TO/rent-radar</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/PATH/TO/rent-radar/.refresh/refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/PATH/TO/rent-radar/.refresh/refresh.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
